package bsc
    ghc-options: -fPIC
    extra-lib-dirs: /Users/npe/src/bsc-new/bsc/src/vendor/yices/v2.6/yices2-inst/lib
    extra-include-dirs: /Users/npe/src/bsc-new/bsc/src/vendor/yices/v2.6/yices2-inst/include
    extra-libraries: yices, gmp

package htcl
    ghc-options: -fPIC
    extra-lib-dirs: /Users/npe/src/bsc-new/bsc/src/vendor/htcl/lib
    extra-include-dirs: /Users/npe/src/bsc-new/bsc/src/vendor/htcl/include

-- Architecture settings
package bsc
    if os(darwin)
        if arch(aarch64)
            cc-options: -arch arm64
            ld-options: -arch arm64
        else
            cc-options: -arch x86_64
            ld-options: -arch x86_64

package htcl
    if os(darwin)
        if arch(aarch64)
            cc-options: -arch arm64
            ld-options: -arch arm64
        else
            cc-options: -arch x86_64
            ld-options: -arch x86_64

package bsc
    extra-lib-dirs: /opt/homebrew/Cellar/tcl-tk@8/8.6.16/lib
    extra-include-dirs: /opt/homebrew/Cellar/tcl-tk@8/8.6.16/include
