packages: .
          src/vendor/htcl

package bsc
    ghc-options: -fPIC -Wno-dodgy-imports
    shared: True
    extra-lib-dirs: ${pkgroot}/src/vendor/htcl
    extra-include-dirs: ${pkgroot}/src/vendor/htcl
    tests: True
    test-show-details: streaming

package htcl
    ghc-options: -fPIC
    shared: True
    extra-lib-dirs: ${pkgroot}/src/vendor/htcl
    extra-include-dirs: ${pkgroot}/src/vendor/htcl

package sbv
    ghc-options: -Wno-dodgy-imports -Wno-unused-imports -Wno-unused-matches -Wno-error=dodgy-imports

optimization: 2
documentation: True
tests: True
test-show-details: streaming
jobs: $ncpus
keep-going: True

allow-newer: all 

package *
  documentation: True
  haddock-html: True
  haddock-hoogle: True
  haddock-internal: True
  shared: True

extra-include-dirs: ${pkgroot}/src/vendor/htcl
extra-lib-dirs: ${pkgroot}/src/vendor/htcl
