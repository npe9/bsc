packages: .
          src/vendor/htcl

with-compiler: ghc-9.2.8

constraints: text >=1.2.4.0,
            template-haskell >=2.18.0.0,
            base >=4.16.4.0,
            transformers >= 0.5.6.2,
            transformers-compat >= 0.6.6

allow-newer: *:base, *:template-haskell, *:text

tests: True

per-component: True

package *
  ghc-options: -Wno-incomplete-uni-patterns -Wno-error=incomplete-uni-patterns -Wno-error -w -fno-warn-incomplete-uni-patterns -fno-warn-error=incomplete-uni-patterns -Wno-all -Wno-everything -Wno-error=all -Wno-error=everything

package sbv
  ghc-options: -Wno-incomplete-uni-patterns -Wno-error=incomplete-uni-patterns -Wno-error -w -fno-warn-incomplete-uni-patterns -fno-warn-error=incomplete-uni-patterns -Wno-all -Wno-everything -Wno-error=all -Wno-error=everything

package bsc
  ghc-options: -v3

package htcl
  ghc-options: -v3

package transformers
  ghc-options: -Wno-unused-imports -Wno-redundant-constraints

package transformers-compat
  flags: +generic-deriving
  ghc-options: -XUndecidableInstances 
               -XFlexibleContexts 
               -XFlexibleInstances 
               -XMultiParamTypeClasses 
               -XTypeFamilies 
               -XDeriveGeneric 
               -XStandaloneDeriving 
               -XDerivingStrategies 
               -XDerivingVia 
               -XScopedTypeVariables 
               -XKindSignatures 
               -XRankNTypes 
               -XGADTs 
               -XEmptyDataDecls 
               -XDataKinds 
               -XPolyKinds 
               -XFunctionalDependencies
               -XDefaultSignatures
               -XConstraintKinds
               -XQuantifiedConstraints
               -XImpredicativeTypes
               -XLiberalTypeSynonyms
               -XExistentialQuantification
               -XIncoherentInstances
               -XUndecidableSuperClasses
               -Wno-unused-imports
               -Wno-redundant-constraints
