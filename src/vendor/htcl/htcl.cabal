name: htcl
version: 0.1.0.0
license: BSD3
license-file: LICENSE
maintainer: Bluespec, Inc.
author: Bluespec, Inc.
synopsis: Haskell Tcl interface
description: A Haskell interface to Tcl
category: Foreign
build-type: Simple
cabal-version: >=1.10

library
    exposed-modules: HTcl
    build-tool-depends: hsc2hs:hsc2hs
    cc-options: -Wall -DTCL86 -fPIC -DTCL_WITH_EXTERNAL_TOMMATH
    ghc-options: -Wall -fPIC -threaded -dynamic
    pkgconfig-depends: tcl >= 8.6
    c-sources: haskell.c
    hs-source-dirs: .
    default-language: Haskell2010
    extra-libraries:
        HSrts-1.0.2
        ffi
        tcl8.6
        tcl9.0
        tclstub
    extra-lib-dirs:
        /Users/npe/.ghcup/ghc/9.10.1/lib/ghc-9.10.1/lib/aarch64-osx-ghc-9.10.1/rts-1.0.2
        /opt/homebrew/opt/libffi/lib
        /opt/homebrew/Cellar/tcl-tk@8/8.6.16/lib
        /opt/homebrew/lib
        /opt/homebrew/Cellar/tcl-tk/9.0.1/lib
    include-dirs:
        /Users/npe/.ghcup/ghc/9.10.1/lib/ghc-9.10.1/lib/aarch64-osx-ghc-9.10.1/rts-1.0.2/include
        /opt/homebrew/Cellar/tcl-tk@8/8.6.16/include
        /opt/homebrew/include
        /opt/homebrew/Cellar/tcl-tk/9.0.1/include/tcl-tk
        /opt/homebrew/Cellar/libtommath/1.3.0/include
    install-includes: HTcl.h
    build-depends:
        base >= 4.20.0.0 && < 4.21,
        time >= 1.9 && < 2.0
    ghc-shared-options: -dynamic -shared 