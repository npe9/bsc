# Builder stage for BSC
ARG GHC_VERSION=9.2.8
FROM ghcr.io/npe9/bsc-ghc-base-${GHC_VERSION}

# Install build dependencies
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    autoconf \
    bison \
    ccache \
    flex \
    g++ \
    gcc \
    git \
    iverilog \
    libgmp-dev \
    libncurses-dev \
    make \
    pkg-config \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Set up ccache directory
RUN mkdir -p /work/.ccache && \
    chmod 777 /work/.ccache

# Create and set working directory
WORKDIR /work/bsc
RUN git clone --recursive https://github.com/B-Lang-org/bsc .

# Build BSC
RUN . /root/.ghcup/env && \
    make install-src PREFIX=/work/inst

# Add BSC to PATH
ENV PATH="/work/inst/bin:${PATH}"

# Set default command
CMD ["bash"] 