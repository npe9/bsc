ARG GHC_VERSION=9.2.8
ARG UBUNTU_VERSION=20.04
FROM ghcr.io/npe9/bsc-ghc-base-${GHC_VERSION}

# Install build dependencies
RUN apt-get update && apt-get install -y \
    autoconf \
    bison \
    ccache \
    flex \
    g++ \
    gcc \
    git \
    gperf \
    iverilog \
    libgmp-dev \
    libncurses-dev \
    make \
    pkg-config \
    python3 \
    python3-pip \
    python3-venv \
    tcl \
    tcl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /work

# Copy BSC source code
COPY . .

# Build BSC
RUN . /root/.ghcup/env && \
    make install-src PREFIX=/work/inst

# Add BSC binaries to PATH
ENV PATH="/work/inst/bin:${PATH}" 