executable bsc
  import:              shared-properties
  main-is:             Main_bsc.hs
  other-modules:       BuildVersion
                       BuildSystem
  build-depends:       bsc
  hs-source-dirs:      src/comp
                       .
  include-dirs:        src/vendor/stp/include
                       src/vendor/yices/include
                       src/vendor/htcl
  extra-lib-dirs:      src/vendor/stp/lib
                       src/vendor/yices/lib
                       src/vendor/htcl
  extra-libraries:     stp
                       yices
                       htcl
  if os(darwin)
    ghc-options:       -optl -headerpad_max_install_names

executable bsc2bsv
  import:              shared-properties
  main-is:             Main_bsc2bsv.hs
  hs-source-dirs:      src/comp
                       .
  if os(darwin)
    ghc-options:       -optl -headerpad_max_install_names

executable bsv2bsc
  import:              shared-properties
  main-is:             Main_bsv2bsc.hs
  hs-source-dirs:      src/comp
                       .
  if os(darwin)
    ghc-options:       -optl -headerpad_max_install_names

test-suite bsc-test
  import:              shared-properties
  type:                exitcode-stdio-1.0
  main-is:             TestMain.hs
  other-modules:       DejaGNUDriver
                       DejaGNUTest
  build-depends:       bsc,
                       tasty,
                       tasty-hunit,
                       text,
                       filepath,
                       directory,
                       process
  hs-source-dirs:      testsuite
  default-language:    Haskell2010 