test-suite bsc-tests
    import:           common-options
    type:            exitcode-stdio-1.0
    main-is:         TestMain.hs
    hs-source-dirs:  testsuite
    build-depends:   base >=4.16.4.0 && <4.17
                   , bsc
                   , tasty >=1.4.3
                   , tasty-hunit >=0.10.0.3
                   , tasty-golden >=2.3.5
                   , directory >=1.3.6.0 && <1.4
                   , filepath >=1.4.2.1 && <1.5
                   , process >=1.6.9.0 && <1.7
                   , containers >=0.6.2.1 && <0.7
                   , text >=1.2.4.0 && <1.3
    other-modules:   BSC.Verilog.Tests
                   , BSC.Bluesim.Tests
                   , BSC.Typechecker.Tests
    data-files:      bsc.verilog/**/*.bsv
                   , bsc.verilog/**/*.bs
                   , bsc.verilog/**/*.out.expected
                   , bsc.bluesim/**/*.bsv
