cabal-version:       2.4
name:                bsc
version:             0.1.0.0
synopsis:            Bluespec Compiler
description:         Bluespec Compiler tools
license:             BSD-3-Clause
author:              Bluespec
maintainer:          info@bluespec.com
category:            Development
extra-source-files:  CHANGELOG.md
build-type:          Simple

common shared-properties
  default-language:    Haskell2010
  default-extensions:  CPP
  ghc-options:        -Wall
                      -fno-warn-orphans
                      -fno-warn-name-shadowing
                      -fno-warn-unused-matches
                      -rtsopts
                      -with-rtsopts=-H256m -i1
  build-depends:       base,
                       array,
                       directory,
                       mtl,
                       containers,
                       old-time,
                       process,
                       random,
                       syb,
                       unix,
                       filepath,
                       pretty,
                       bytestring,
                       text,
                       utf8-string,
                       stm,
                       parallel,
                       haskeline,
                       terminfo,
                       xhtml,
                       time,
                       regex-compat,
                       parsec,
                       integer-gmp,
                       transformers,
                       split

