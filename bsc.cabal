cabal-version:      3.0
name:               bsc
version:            2024.3.0
synopsis:          Bluespec Compiler
description:       The Bluespec Compiler (BSC) is a compiler and simulator for the Bluespec Hardware Description Language.
homepage:          https://github.com/B-Lang-org/bsc
bug-reports:       https://github.com/B-Lang-org/bsc/issues
license:           BSD-3-Clause
license-file:      LICENSE.txt
author:            Bluespec Inc.
maintainer:        B-Lang Maintainers
category:          Hardware
build-type:        Custom
extra-doc-files:   README.md
                   INSTALL.md
                   DEVELOP.md
tested-with:       GHC == 9.2.8

data-dir:          src/Libraries
data-files:        Base1/*.bs
                   Base1/*.bsv
                   Base2/*.bs
                   Base2/*.bsv
                   Base3-Contexts/*.bs
                   Base3-Contexts/*.bsv
                   Base3-Math/*.bsv
                   Base3-Misc/*.bs
                   Base3-Misc/*.bsv

extra-source-files: testsuite/config/*.tcl
                   testsuite/lib/*.exp
                   testsuite/bsc.evaluator/**/*.exp
                   testsuite/bsc.typechecker/**/*.exp
                   testsuite/bsc.lib/**/*.exp
                   testsuite/bsc.if/**/*.exp
                   testsuite/bsc.names/**/*.exp
                   testsuite/bsc.bluetcl/**/*.exp
                   testsuite/bsc.interra/**/*.exp
                   testsuite/bsc.bluesim/**/*.exp
                   testsuite/bsc.bugs/bluespec_inc/**/*.exp
                   testsuite/bsc.bugs/github/**/*.exp
                   testsuite/bsc.bugs/pre_bluespec_inc/**/*.exp
                   testsuite/site.exp
                   src/Libraries/Base1/*.bs
                   src/Libraries/Base1/*.bsv
                   src/Libraries/Base2/*.bs
                   src/Libraries/Base2/*.bsv
                   src/Libraries/Base3-Contexts/*.bs
                   src/Libraries/Base3-Contexts/*.bsv
                   src/Libraries/Base3-Math/*.bsv
                   src/Libraries/Base3-Misc/*.bs
                   src/Libraries/Base3-Misc/*.bsv
                   src/bluetcl/*.tcl

extra-tmp-files:   build/bsvlib/*.bo
                   build/bsvlib/*.bi
                   build/bsvlib/*.ba
                   build/tcllib/bluespec/tclIndex
                   build/tcllib/bluespec/pkgIndex.tcl

common common-options
    default-language: Haskell2010
    ghc-options:      -Wall
                      -Wcompat
                      -Widentities
                      -Wno-incomplete-uni-patterns
                      -Wno-incomplete-record-updates
                      -fno-warn-orphans
                      -fno-warn-name-shadowing
                      -fno-warn-unused-matches
                      -Wno-dodgy-imports
                      -fhpc
                      -fPIC
                      -Wno-error=incomplete-uni-patterns
                      -Wno-error
    if impl(ghc >= 8.0)
        ghc-options:    -Wredundant-constraints
    if impl(ghc >= 8.2)
        ghc-options:    -fhide-source-paths
    if impl(ghc >= 8.4)
        ghc-options:    -Wmissing-export-lists
                        -Wno-partial-fields
    if impl(ghc >= 8.10)
        ghc-options:    -Wunused-packages

    -- Architecture-specific flags
    if os(darwin)
        if arch(aarch64)
            cc-options: -arch arm64 -fPIC
            ld-options: -arch arm64 -fPIC
        else
            cc-options: -arch x86_64 -fPIC
            ld-options: -arch x86_64 -fPIC
    if os(linux)
        cc-options: -fPIC
        ld-options: -fPIC

    -- TCL library configuration
    if os(darwin)
        if arch(aarch64)
            extra-lib-dirs: /opt/homebrew/lib
            extra-libraries: tcl9.0
        else
            extra-lib-dirs: /usr/local/lib
            extra-libraries: tcl9.0
    if os(linux)
        extra-lib-dirs: /usr/lib/x86_64-linux-gnu
        extra-libraries: tcl9.0
    if os(windows)
        extra-lib-dirs: C:/tcl/lib
        extra-libraries: tcl90

custom-setup
    setup-depends: base >= 4.16.4.0 && <4.17
                , Cabal >= 3.0.0.0
                , directory >= 1.3.6.0
                , filepath >= 1.4.2.1
                , process >= 1.6.9.0
                , unix >= 2.7.2.2 && <2.8

-- Add custom build targets
custom-target build-prelude
    type: build
    command: mkdir -p build/bsvlib && bsc -p . -bdir build/bsvlib -no-use-prelude src/Libraries/Base1/MinimalPrelude.bs && BSC_PATH=build/bsvlib:$BSC_PATH bsc -p . -bdir build/bsvlib src/Libraries/Base1/Prelude.bs && bsc -p . -bdir build/bsvlib src/Libraries/Base1/PreludeBSV.bsv

custom-target build-libraries
    type: build
    command: for f in src/Libraries/Base2/*.bs src/Libraries/Base2/*.bsv; do if [ -f "$f" ]; then echo "Compiling $f..."; bsc -p . -bdir build/bsvlib "$f"; fi; done && for d in src/Libraries/Base3-*; do if [ -d "$d" ]; then echo "Compiling in $d..."; for f in "$d"/*.bsv; do if [ -f "$f" ]; then echo "Compiling $f..."; bsc -p . -bdir build/bsvlib "$f"; fi; done; fi; done

custom-target clean-prelude
    type: clean
    command: rm -rf build/bsvlib/* && cd src/vendor/htcl && cabal clean && rm -f HTcl.h && cd ../../..

custom-target clean-htcl
    type: clean
    command: cd src/vendor/htcl && cabal clean && rm -f HTcl.h && cd ../../..

