executable bsc
    import:           common-options
    hs-source-dirs:   src/exec
    main-is:          Main.hs
    build-depends:    bsc
                   , base >=4.20.0.0 && <4.21
                   , directory >=1.3.6.0 && <1.4
                   , filepath >=1.4.2.1 && <1.5
                   , process >=1.6.9.0 && <1.7
                   , unix >=2.7.2.2 && <2.8
                   , gitrev >=1.3.1
                   , array >=0.5.4.0 && <0.6
                   , containers >=0.6.2.1 && <0.7
                   , mtl >=2.2.2 && <2.3
                   , parsec >=3.1.14.0 && <3.2
                   , split >=0.2.5 && <0.3
                   , text >=1.2.4.0 && <1.3
                   , bytestring >=0.10.10.1 && <0.12
                   , regex-compat >=0.95.2.2 && <0.96
                   , old-time >=1.1.0.4 && <1.2
                   , time >=1.9.3 && <1.10
                   , integer-gmp >=1.0.2.0 && <1.2
    extra-libraries: HSrts-1.0.2
                    , ffi
                    , tcl8.6
                    , tcl9.0
                    , tclstub
                    , HShtcl-0.1.0.0-inplace
    include-dirs: ${pkgroot}/src/vendor/htcl
    extra-lib-dirs: ${pkgroot}/src/vendor/htcl

executable bluetcl
    import:           common-options
    hs-source-dirs:   src/bluetcl src/comp
    c-sources: src/vendor/htcl/haskell.c
    main-is:          Main.hs
    build-depends:    bsc
                   , base >=4.20.0.0 && <4.21
                   , directory >=1.3.6.0 && <1.4
                   , filepath >=1.4.2.1 && <1.5
                   , process >=1.6.9.0 && <1.7
                   , unix >=2.7.2.2 && <2.8
                   , gitrev >=1.3.1
                   , array >=0.5.4.0 && <0.6
                   , containers >=0.6.2.1 && <0.7
                   , mtl >=2.2.2 && <2.3
                   , parsec >=3.1.14.0 && <3.2
                   , split >=0.2.5 && <0.3
                   , text >=1.2.4.0 && <1.3
                   , bytestring >=0.10.10.1 && <0.12
                   , regex-compat >=0.95.2.2 && <0.96
                   , old-time >=1.1.0.4 && <1.2
                   , time >=1.9.3 && <1.10
                   , integer-gmp >=1.0.2.0 && <1.2
                   , syb >=0.7.2.4 && <0.8
                   , sbv ==11.3
                   , generic-data >=1.0.0
    extra-libraries: HSrts-1.0.2
                    , ffi
                    , tcl8.6
                    , tcl9.0
                    , tclstub
                    , HShtcl-0.1.0.0-inplace
    include-dirs: ${pkgroot}/src/vendor/htcl
    extra-lib-dirs: ${pkgroot}/src/vendor/htcl
    build-tool-depends: hsc2hs:hsc2hs
    other-modules:    BlueTcl

test-suite bsc-tests
    type:                exitcode-stdio-1.0
    main-is:            TestMain.hs
    hs-source-dirs:     testsuite
    build-depends:      base >=4.20.0.0 && <4.21
                     , directory >=1.3.6.0 && <1.4
                     , filepath >=1.4.2.1 && <1.5
                     , process >=1.6.9.0 && <1.7
                     , bsc
                     , tasty
                     , tasty-hunit
                     , optparse-applicative >=0.15.1.0 && <0.16
    extra-source-files: testsuite/config/*.tcl
                     , testsuite/lib/*.exp
                     , testsuite/bsc.evaluator/**/*.exp
                     , testsuite/bsc.typechecker/**/*.exp
                     , testsuite/bsc.lib/**/*.exp
                     , testsuite/bsc.if/**/*.exp
                     , testsuite/bsc.names/**/*.exp
                     , testsuite/bsc.bluetcl/**/*.exp
                     , testsuite/bsc.interra/**/*.exp
                     , testsuite/bsc.bluesim/**/*.exp
                     , testsuite/bsc.bugs/bluespec_inc/**/*.exp
                     , testsuite/bsc.bugs/github/**/*.exp
                     , testsuite/bsc.bugs/pre_bluespec_inc/**/*.exp
                     , testsuite/site.exp
    data-files:         testsuite/config/*.tcl
                     , testsuite/lib/*.exp
                     , testsuite/bsc.evaluator/**/*.exp
                     , testsuite/bsc.typechecker/**/*.exp
                     , testsuite/bsc.lib/**/*.exp
                     , testsuite/bsc.if/**/*.exp
                     , testsuite/bsc.names/**/*.exp
                     , testsuite/bsc.bluetcl/**/*.exp
                     , testsuite/bsc.interra/**/*.exp
                     , testsuite/bsc.bluesim/**/*.exp
                     , testsuite/bsc.bugs/bluespec_inc/**/*.exp
                     , testsuite/bsc.bugs/github/**/*.exp
                     , testsuite/bsc.bugs/pre_bluespec_inc/**/*.exp
                     , testsuite/site.exp
    default-language:   Haskell2010
    ghc-options:        -Wall
                      -Wcompat
                      -Widentities
                      -Wno-incomplete-uni-patterns
                      -Wno-incomplete-record-updates
                      -fno-warn-orphans
                      -fno-warn-name-shadowing
                      -fno-warn-unused-matches
                      -Wno-dodgy-imports

if os(darwin)
    if arch(aarch64)
        cc-options: -arch arm64
        ld-options: -arch arm64
    else
        cc-options: -arch x86_64
        ld-options: -arch x86_64

data-files:     src/Libraries/Base1/*.bs
                src/Libraries/Base1/*.bsv
                src/Libraries/Base2/*.bs
                src/Libraries/Base2/*.bsv
                src/Libraries/Base3-Contexts/*.bs
                src/Libraries/Base3-Contexts/*.bsv
                src/Libraries/Base3-Math/*.bs
                src/Libraries/Base3-Math/*.bsv
                src/Libraries/Base3-Misc/*.bs
                src/Libraries/Base3-Misc/*.bsv
                src/bluetcl/*.tcl

extra-tmp-files: build/bsvlib/*.bo
                build/bsvlib/*.bi
                build/bsvlib/*.ba
                build/tcllib/bluespec/tclIndex
                build/tcllib/bluespec/pkgIndex.tcl

build-type:     Custom

