executable bsc
    import:           common-options
    hs-source-dirs:   src/exec
    main-is:          Main.hs
    build-depends:    bsc
                   , base ==4.13.0.0
                   , directory ==1.3.6.0
                   , filepath ==1.4.2.1
                   , process ==1.6.9.0
                   , unix ==2.7.2.2
                   , gitrev >=1.3.1
                   , array ==0.5.4.0
                   , containers ==0.6.2.1
                   , mtl ==2.2.2
                   , parsec ==3.1.14.0
                   , split ==0.2.5
                   , text ==1.2.4.0
                   , bytestring ==0.10.10.1
                   , regex-compat ==0.95.2.2
                   , old-time ==1.1.0.4
                   , time ==1.9.3
                   , integer-gmp ==1.0.2.0

