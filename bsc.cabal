cabal-version:      3.0
name:               bsc
version:            2024.3.0
synopsis:          Bluespec Compiler
description:       The Bluespec Compiler (BSC) is a compiler and simulator for the Bluespec Hardware Description Language.
homepage:          https://github.com/B-Lang-org/bsc
bug-reports:       https://github.com/B-Lang-org/bsc/issues
license:           BSD-3-Clause
license-file:      LICENSE.txt
author:            Bluespec Inc.
maintainer:        B-Lang Maintainers
category:          Hardware
build-type:        Custom
extra-doc-files:   README.md
                   INSTALL.md
                   DEVELOP.md
tested-with:       GHC == 9.8.1
extra-source-files: testsuite/config/*.tcl
                   testsuite/lib/*.exp
                   testsuite/bsc.evaluator/**/*.exp
                   testsuite/bsc.typechecker/**/*.exp
                   testsuite/bsc.lib/**/*.exp
                   testsuite/bsc.if/**/*.exp
                   testsuite/bsc.names/**/*.exp
                   testsuite/bsc.bluetcl/**/*.exp
                   testsuite/bsc.interra/**/*.exp
                   testsuite/bsc.bluesim/**/*.exp
                   testsuite/bsc.bugs/bluespec_inc/**/*.exp
                   testsuite/bsc.bugs/github/**/*.exp
                   testsuite/bsc.bugs/pre_bluespec_inc/**/*.exp
                   testsuite/site.exp
                   src/Libraries/Base1/*.bs
                   src/Libraries/Base1/*.bsv
                   src/Libraries/Base2/*.bs
                   src/Libraries/Base2/*.bsv
                   src/Libraries/Base3-Contexts/*.bs
                   src/Libraries/Base3-Contexts/*.bsv
                   src/Libraries/Base3-Math/*.bs
                   src/Libraries/Base3-Math/*.bsv
                   src/Libraries/Base3-Misc/*.bs
                   src/Libraries/Base3-Misc/*.bsv
                   src/bluetcl/*.tcl

common common-options
    default-language: Haskell2010
    ghc-options:      -Wall
                      -Wcompat
                      -Widentities
                      -Wno-incomplete-uni-patterns
                      -Wno-incomplete-record-updates
                      -fno-warn-orphans
                      -fno-warn-name-shadowing
                      -fno-warn-unused-matches
                      -Wno-dodgy-imports
    if impl(ghc >= 8.0)
        ghc-options:    -Wredundant-constraints
    if impl(ghc >= 8.2)
        ghc-options:    -fhide-source-paths
    if impl(ghc >= 8.4)
        ghc-options:    -Wmissing-export-lists
                        -Wno-partial-fields
    if impl(ghc >= 8.10)
        ghc-options:    -Wunused-packages

custom-setup
    setup-depends: base >= 4.20.0.0 && <4.21
                , Cabal >= 3.0.0.0
                , directory >= 1.3.6.0
                , filepath >= 1.4.2.1
                , process >= 1.6.9.0
                , unix >= 2.7.2.2 && <2.8

library
    import:           common-options
    hs-source-dirs:   src/comp
                      src/Libraries/Base1
                      src/Libraries/Base2
                      src/Libraries/Base3-Math
                      src/Libraries/Base3-Misc
                      src/Libraries/Base3-Contexts
                      src/comp/Libs
                      src/comp/GHC/posix
                      src/comp/Parser/BSV
                      src/vendor/htcl
    build-depends:    base >=4.20.0.0 && <4.21
                   , array >=0.5.4.0 && <0.6
                   , containers >=0.6.2.1 && <0.7
                   , directory >=1.3.6.0 && <1.4
                   , filepath >=1.4.2.1 && <1.5
                   , mtl >=2.2.2 && <2.3
                   , parsec >=3.1.14.0 && <3.2
                   , process >=1.6.9.0 && <1.7
                   , syb >=0.7.2.4 && <0.8
                   , unix >=2.7.2.2 && <2.8
                   , split >=0.2.5 && <0.3
                   , text >=1.2.4.0 && <1.3
                   , bytestring >=0.10.10.1 && <0.12
                   , regex-compat >=0.95.2.2 && <0.96
                   , old-time >=1.1.0.4 && <1.2
                   , time >=1.9.3 && <1.10
                   , gitrev >=1.3.1
                   , sbv ==11.3
                   , syb >=0.7.2.4 && <0.8
                   , htcl
    include-dirs: src/vendor/htcl
    extra-lib-dirs: src/vendor/htcl
    extra-libraries: HSrts-1.0.2
                   , ffi
                   , tcl8.6
                   , tcl9.0
                   , tclstub
                   , HShtcl-0.1.0.0-inplace
    data-dir: src/Libraries
    data-files: Base1/*.bs
                Base1/*.bsv
                Base2/*.bs
                Base2/*.bsv
                Base3-Contexts/*.bs
                Base3-Contexts/*.bsv
                Base3-Math/*.bs
                Base3-Math/*.bsv
                Base3-Misc/*.bs
