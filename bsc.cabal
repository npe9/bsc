    import:           common-options
    hs-source-dirs:   src/bluetcl src/comp
    c-sources: src/vendor/htcl/haskell.c
    main-is:          Main.hs
    build-depends:    bsc
                   , base ==4.13.0.0
                   , directory ==1.3.6.0
                   , filepath ==1.4.2.1
                   , process ==1.6.9.0
                   , unix ==2.7.2.2
