repository hackage.haskell.org
  url: http://hackage.haskell.org/
  secure: True
  root-keys: 0a5c7ea47cd1b15f800f7289e56d51643c87d179
  key-threshold: 3

remote-repo-cache: /root/.cabal/packages
local-repo: /root/.cabal/packages
package-db: /root/.cabal/store/ghc-9.6.6/package.db
extra-prog-path: /root/.cabal/bin

install-dirs user
  prefix: /root/.cabal

build-summary: /root/.cabal/logs/build.log
remote-build-reporting: anonymous
jobs: $ncpus 